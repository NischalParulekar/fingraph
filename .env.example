# Copy to .env (git-ignored) and fill in. Only paid runs need it.
ANTHROPIC_API_KEY=

# Optional: Amazon Bedrock instead of the direct API (docs/bedrock.md). Credentials come
# from an AWS SSO profile, never from this file. Uncomment to use.
# LLM_PROVIDER=bedrock
# AWS_PROFILE=
# AWS_REGION=ap-south-1
# BEDROCK_MODEL_ID=global.anthropic.claude-haiku-5-5

# Optional: LangSmith tracing, off unless set. Uncomment to use.
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=fingraph
