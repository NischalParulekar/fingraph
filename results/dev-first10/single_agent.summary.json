    "retrieval": {
      "mode": "context",
      "k": 3,
      "embedding_model": "BAAI/bge-small-en-v1.5",
      "embedding_revision": "5c38ec7c405ec4b44b94cc5a9bb96e735b38267a"
    },
    "system_prompt": "You answer questions about one company's financial report. The report has a table and a few paragraphs of text, and the tools are your only access to them:\n- query_table runs SQL against the table,\n- retrieve_text searches the paragraphs,\n- calculate does arithmetic.\n\nHow to work\n- Start by looking at the table with query_table (it is small, so SELECT * is fine) and, if the question may be answered in the text, by searching the paragraphs. You can call several tools in the same turn.\n- Read the header rows: they say which column is which period and what unit the amounts are in.\n- Do every calculation with calculate.\n- Call final_answer when you have the answer. Text you write outside a tool call is not read.\n- You have at most 10 turns, so answer once you are confident.\n\nHow the answer is scored\n- It is compared with a gold answer automatically, so give only the answer itself, never a sentence or an explanation.\n- Text answers: copy the words exactly as they appear in the table or the paragraph.\n- If the question asks for several items, give each one as its own list entry.\n- Numbers you calculate (differences, changes, totals, averages, ratios, percentages): compute them with the calculate tool, never in your head, and give the result rounded to 2 decimal places as a bare number, without currency signs or %.\n- Percentage change is (new - old) / old * 100.\n- Counts: the count as a bare number.\n- `scale` is the unit the number is in. Use \"thousand\", \"million\" or \"billion\" for an amount that the report states in those units (for example a table headed \"In thousands\"), also when you copy the amount as it is. Use \"percent\" for any percentage (give 12.5 for 12.5%). Use \"\" for counts, years, plain ratios and text answers.\n",
    "tools": [
      {
        "name": "query_table",
        "description": "Run one read-only DuckDB SELECT statement against the report's table `t` and return the result. If the query fails, the error comes back so you can fix it.",
        "strict": true,
        "input_schema": {
          "type": "object",
          "properties": {
            "sql": {
              "type": "string",
              "description": "A single SELECT statement."
            }
          },
          "required": [
            "sql"
          ],
          "additionalProperties": false
        }
      },
      {
        "name": "retrieve_text",
        "description": "Search the report's paragraphs and return the 3 most relevant ones, best first, each with its paragraph number.",
        "strict": true,
        "input_schema": {
          "type": "object",
          "properties": {
            "query": {
              "type": "string",
              "description": "What to look for, in plain words."
            }
          },
          "required": [
            "query"
          ],
          "additionalProperties": false
        }
      },
      {
        "name": "calculate",
        "description": "Evaluate an arithmetic expression exactly: numbers, + - * / and parentheses only. Example: \"(1320 - 1086) / 1086 * 100\".",
        "strict": true,
        "input_schema": {
          "type": "object",
          "properties": {
            "expression": {
              "type": "string",
              "description": "The expression to evaluate."
            }
          },
          "required": [
            "expression"
          ],
          "additionalProperties": false
        }
      },
      {
        "name": "final_answer",
        "description": "Give the final answer and finish. This is the only way to answer.",
        "strict": true,
        "input_schema": {
          "type": "object",
          "properties": {
            "answer": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "The answer: one entry, or one entry per item for a list."
            },
            "scale": {
              "type": "string",
              "enum": [
                "",
                "thousand",
                "million",
                "billion",
                "percent"
              ],
              "description": "The unit the answer is expressed in."
            }
          },
          "required": [
            "answer",
            "scale"
          ],
          "additionalProperties": false
        }
      }
    ]
  },
